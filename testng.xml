<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Decathlon QA Automation Suite" verbose="1">

    <listeners>
        <listener class-name="org.testng.reporters.jq.Main"/>
        <listener class-name="org.testng.reporters.EmailableReporter2"/>
        <listener class-name="org.testng.reporters.XMLReporter"/>
        <listener class-name="org.testng.reporters.JUnitReportReporter"/>
    </listeners>

    <test name="Decathlon E2E Tests">
        <classes>
            <class name="Tests.TC01_SearchAndOpenProduct"/>
            <class name="Tests.TC02_ProductCategoryFilters"/>
            <class name="Tests.TC03_VerifyDescendingSort"/>
            <class name="Tests.TC04_AddToCartAndVerifyOrderTotal"/>
            <class name="Tests.TC05_UpdateCartQuantities"/>
            <class name="Tests.TC06_EmptyCartVerification"/>
        </classes>
    </test>

</suite>